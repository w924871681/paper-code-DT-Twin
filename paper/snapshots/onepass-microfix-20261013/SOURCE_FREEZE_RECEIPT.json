          "bytes": 113,
          "sha256": "6c153ca237230449cab06bca731555363a5023601ed04030c2382c1bdf5591d7",
          "text": " NAS-related labels denote task-matched control implementations, not exact reproductions of published algorithms."
        }
      },
      {
        "id": "S7.1",
        "new_span": {
          "id": "S7.1",
          "byte_start": 45687,
          "byte_end_exclusive": 45818,
          "line_start": 1069,
          "line_end": 1070,
          "bytes": 131,
          "sha256": "877b12549c5ee7e5fcd11604cdceac0ca33fb47ffcd03c2a83df2dcfc4f2a457",
          "text": "The reference-only and two-reference-initialization variants do not reproduce\nthe gain of the complete heterogeneous-bank pipeline."
        }
      },
      {
        "id": "S7.2",
        "new_span": {
          "id": "S7.2",
