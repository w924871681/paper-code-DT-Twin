    "edits": [
      {
        "id": "S4",
        "new_span": {
          "id": "S4",
          "byte_start": 27447,
          "byte_end_exclusive": 27848,
          "line_start": 701,
          "line_end": 706,
          "bytes": 401,
          "sha256": "f614f490cf1daa07bc1b700fb3710d2faa7d47370cc56b15cad1b3bef51f46ab",
          "text": "The paired-initialization control adapts both source-trained A57 candidates on\nthe same support set and applies the same relative-margin rule at each $\\tau$ to\nselect one using validation loss. The selected model's check-set loss is the\npaired-control denominator; because the two source-training recipes differ, this\nis a same-architecture selection control rather than a random-seed-only\ncomparison."
        }
      },
      {
        "id": "S6",
        "new_span": {
          "id": "S6",
          "byte_start": 36984,
          "byte_end_exclusive": 37097,
          "line_start": 891,
